<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.iteam.javafx.controller.LoginController"
      prefWidth="900" prefHeight="600">

    <!-- Left branding panel -->
    <VBox prefWidth="360" spacing="0" styleClass="login-left">
        <VBox.margin><Insets/></VBox.margin>
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="logo-box">
                <Label text="IT" styleClass="logo-text"/>
            </StackPane>
            <VBox>
                <Label text="ITEAM University" styleClass="brand-name"/>
                <Label text="Système de réservation" styleClass="brand-sub"/>
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="Gestion des salles de conférence" styleClass="brand-title" wrapText="true"/>
        <Label text="Réservez vos espaces de travail, gérez les équipements et optimisez l'utilisation des ressources de l'université."
               styleClass="brand-desc" wrapText="true">
            <VBox.margin><Insets top="16" bottom="32"/></VBox.margin>
        </Label>

        <!-- Stats grid -->
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="8" styleClass="stat-value"/>
                <Label text="Salles disponibles" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="7" styleClass="stat-value"/>
                <Label text="Utilisateurs actifs" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="40+" styleClass="stat-value"/>
                <Label text="Réservations/mois" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="80%" styleClass="stat-value"/>
                <Label text="Taux d'occupation" styleClass="stat-label"/>
            </VBox>
        </GridPane>

        <Region VBox.vgrow="ALWAYS"/>
        <Label text="© 2025 ITEAM University — Tous droits réservés" styleClass="brand-footer"/>
    </VBox>

    <!-- Right form panel -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="login-right" spacing="0">
        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>
        <VBox maxWidth="360" spacing="0">
            <Label text="Connexion" styleClass="form-title"/>
            <Label text="Entrez vos identifiants pour accéder au système." styleClass="form-subtitle">
                <VBox.margin><Insets top="4" bottom="28"/></VBox.margin>
            </Label>

            <!-- Error box -->
            <HBox fx:id="errorBox" styleClass="error-box" spacing="8" alignment="CENTER_LEFT">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Label text="⚠" styleClass="error-icon"/>
                <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>
                <HBox.margin><Insets bottom="16"/></HBox.margin>
            </HBox>

            <!-- Email -->
            <Label text="Adresse email" styleClass="field-label"/>
            <TextField fx:id="emailField" styleClass="text-input" promptText="votre@email.tn">
                <VBox.margin><Insets top="4" bottom="16"/></VBox.margin>
            </TextField>

            <!-- Password -->
            <Label text="Mot de passe" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" styleClass="text-input" promptText="••••••••">
                <VBox.margin><Insets top="4" bottom="24"/></VBox.margin>
            </PasswordField>

            <!-- Login button -->
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="loginBtn" text="Se connecter" styleClass="btn-primary"
                        onAction="#handleLogin" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="spinner" prefWidth="24" prefHeight="24" visible="false"/>
            </HBox>

            <!-- Separator -->
            <Separator>
                <VBox.margin><Insets top="28" bottom="20"/></VBox.margin>
            </Separator>

            <!-- Demo accounts -->
            <Label text="Comptes de démonstration" styleClass="demo-label">
                <VBox.margin><Insets bottom="10"/></VBox.margin>
            </Label>
            <HBox spacing="8">
                <Button text="Admin" styleClass="btn-demo" onAction="#fillAdmin" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Manager" styleClass="btn-demo" onAction="#fillManager" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Utilisateur" styleClass="btn-demo" onAction="#fillUser" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <Label text="Cliquer pour remplir automatiquement" styleClass="demo-hint">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
        </VBox>
    </VBox>
</HBox>
