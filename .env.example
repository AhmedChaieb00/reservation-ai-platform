# Copy to .env and replace every value. NEVER commit .env.
# Generate strong secrets with:  openssl rand -base64 48

# Database
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# JWT signing key (>= 32 characters)
JWT_SECRET=change-me-with-a-long-random-string-32chars-min

# AI service
AI_SECRET_KEY=change-me
# Optional: enables the LLM chatbot (https://console.groq.com). Without it a rule-based fallback is used.
GROQ_API_KEY=

# Allowed browser origins for the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional SMTP for email notifications (use an app password, never your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Set to true to show the demo-account buttons on the login page (demo only)
VITE_DEMO_MODE=false
